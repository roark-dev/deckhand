<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd template: run the deckhand daemon at login on macOS.

     SECURITY: do NOT put your GitHub token in this file. LaunchAgent plists
     are typically world-readable (0644), and `launchctl print` also exposes
     environment variables. Use token_file auth in config.yaml instead:

       github:
         auth:
           token_file: /Users/YOU/.deckhand/token   # chmod 600

     Setup:
     1. Edit the deckhand path below (`which deckhand`).
     2. cp com.deckhand.daemon.plist ~/Library/LaunchAgents/
        chmod 600 ~/Library/LaunchAgents/com.deckhand.daemon.plist
     3. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.deckhand.daemon.plist

     Logs land in ~/.deckhand/daemon.log (0600); launchd's own capture below
     also stays inside ~/.deckhand rather than world-readable /tmp.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.deckhand.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/deckhand</string>
    <string>up</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/REPLACE_ME/.deckhand/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE_ME/.deckhand/launchd.log</string>
</dict>
</plist>
